---
import { t } from '@/lib/utils';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  keywords?: string;
}

const site = Astro.site ?? new URL('https://thenarrativecurrent.com');
const canonicalURL = new URL(Astro.url.pathname, site);

const {
  title = t('meta.index.title'),
  description = t('meta.index.description'),
  image = '/og-image.png',
  keywords = t('meta.index.keywords'),
} = Astro.props;

const imageURL = new URL(image, site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/rss+xml" title="The Narrative Current RSS Feed" href={new URL('rss.xml', site)} />
<link rel="canonical" href={canonicalURL} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:site_name" content="The Narrative Current" />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
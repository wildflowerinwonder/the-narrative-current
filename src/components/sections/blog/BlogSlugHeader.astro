---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  blog: CollectionEntry<'blogs'>;
}

const { blog } = Astro.props;
---

<header class="w-full">

  <h1
    data-blog-heading
    class="text-[2.2rem] leading-[1.25] tracking-[-0.01em] text-[#2B2A27] md:text-6xl lg:text-5xl"
  >
    {blog.data.title}
  </h1>

  {blog.data.topics && blog.data.topics.length > 0 && (
    <div class="mt-8 flex max-w-[1180px] flex-wrap gap-2 md:gap-3">
      {blog.data.topics.map((topic) => (
        <span class=" bg-[#E7E3DD] px-3 py-1.5 font-normal text-[0.6rem] leading-none tracking-[0.05em] text-[#2B2A27] md:px-4 md:py-2 md:text-[0.65rem]">
          {topic}
        </span>
      ))}
    </div>
  )}

  <div class="mt-10 aspect-[16/9] w-full overflow-hidden bg-[#DDD8D1]">
    <Image
      src={blog.data.heroImage}
      alt={blog.data.title}
      class="h-full w-full object-cover"
      loading="eager"
    />
  </div>

</header>
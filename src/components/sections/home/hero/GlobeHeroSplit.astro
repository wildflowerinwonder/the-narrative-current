---
import { t } from '@/lib/utils';
---

<div
  data-hero="section"
  class="relative flex min-h-dvh w-full overflow-hidden bg-background"
>
  <div
    id="hero-bg-image"
    class="absolute inset-0 h-full w-full bg-cover bg-center bg-no-repeat"
    style="
      background-image: url('/hero-image.png');
      visibility: hidden;
      opacity: 0;
    "
  ></div>

  <div class="absolute inset-0 bg-[#2B2A27]/30"></div>

  <div class="absolute inset-0 bg-gradient-to-t from-[#4D463D]/20 via-transparent to-transparent"></div>

  <div
    class="relative z-10 flex min-h-dvh w-full items-center justify-center px-6 pb-[5vh] lg:px-20 xl:px-24 2xl:px-28"
  >
    <div class="flex max-w-4xl flex-col items-center text-center text-white">
      <h1
        id="hero-h1-split"
        class="whitespace-pre-line text-center text-[1.4rem] leading-[1.25] tracking-[0.001em] text-[#FAF9F7] md:text-4xl"
        style="visibility: hidden;"
      >
        <Fragment set:html={t('index.hero.h1')} />
      </h1>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  const heroImage = document.getElementById('hero-bg-image');
  const h1 = document.getElementById('hero-h1-split');

  gsap.set(h1, {
    y: 28,
    opacity: 0,
  });

  gsap.set(heroImage, {
    opacity: 0,
  });

  gsap.set([heroImage, h1], {
    visibility: 'visible',
  });

  gsap
    .timeline({
      defaults: {
        ease: 'power3.out',
      },
    })
    .to(heroImage, {
      opacity: 1,
      duration: 1.4,
      ease: 'power2.out',
    })
    .to(
      h1,
      {
        y: 0,
        opacity: 1,
        duration: 0.85,
        ease: 'power4.out',
      },
      '-=0.55'
    );
</script>
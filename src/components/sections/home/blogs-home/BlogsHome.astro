---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  blogs: CollectionEntry<'blogs'>[];
}

const { blogs } = Astro.props;

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<section
  data-blogs-index="section"
  class="w-full bg-[#FAF9F7] py-20 lg:py-[6.5rem]"
>
  <div class="w-full px-6 lg:px-20 xl:px-24 2xl:px-28">

    <div class="mb-10 flex items-center justify-between lg:mb-12">
      <h2 class="text-[2.4rem] uppercase leading-[1.05] tracking-[0.02em] text-[#2B2A27] md:text-5xl lg:text-4xl">
        IDEAS
      </h2>

      <div class="hidden items-center gap-3 lg:flex">
        <button
          id="ideas-prev"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-[#2B2A27] text-[#FAF9F7] transition-all duration-300 hover:bg-[#DDD8D1] hover:text-[#2B2A27]"
          aria-label="Scroll ideas left"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>

        <button
          id="ideas-next"
          class="flex h-11 w-11 items-center justify-center rounded-full bg-[#2B2A27] text-[#FAF9F7] transition-all duration-300 hover:bg-[#DDD8D1] hover:text-[#2B2A27]"
          aria-label="Scroll ideas right"
          type="button"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>

    <div class="flex flex-col gap-10 pb-3 lg:hidden">
      {blogs.slice(0, 3).map((blog) => (
        <a href={`/blog/${blog.id}`} class="group block w-full">
          <div class="aspect-[1.5/1] w-full overflow-hidden bg-[#DDD8D1]">
            <Image
              src={blog.data.heroImage}
              alt={blog.data.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
              loading="eager"
            />
          </div>

          <p class="mt-4 text-[0.58rem] uppercase tracking-[0.18em] text-[#2B2A27]/35">
            {formatDate(blog.data.pubDate)}
          </p>

          <h3 class="mt-2 text-[1.05rem] leading-[1.22] tracking-[-0.01em] text-[#2B2A27]">
            {blog.data.title}
          </h3>
        </a>
      ))}

      <a
        href="/blog"
        class="group flex h-[50px] w-full items-center justify-center rounded-[0.5rem] border border-[#2B2A27] bg-transparent transition-all duration-300 hover:bg-[#2B2A27]"
      >
        <span class="text-[0.65rem] uppercase tracking-[0.18em] text-[#2B2A27] transition-colors duration-300 group-hover:text-[#FAF9F7]">
          Read More
        </span>
      </a>
    </div>

    <div
      id="ideas-scroll"
      class="scrollbar-hide hidden gap-2 overflow-x-auto scroll-smooth pb-4 lg:flex"
    >
      {blogs.slice(0, 6).map((blog) => (
        <a
          href={`/blog/${blog.id}`}
          class="group w-[31.6vw] max-w-[660px] min-w-[420px] shrink-0"
        >
          <div class="aspect-[1.5/1] w-full overflow-hidden bg-[#DDD8D1]">
            <Image
              src={blog.data.heroImage}
              alt={blog.data.title}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.025]"
              loading="eager"
            />
          </div>

          <p class="mt-2 text-[0.65rem] uppercase tracking-[0.14em] text-[#2B2A27]/35">
            {formatDate(blog.data.pubDate)}
          </p>

          <h3 class="mt-1 text-[1.05rem] leading-[1.22] tracking-[-0.01em] text-[#2B2A27]">
            {blog.data.title}
          </h3>
        </a>
      ))}

      <a
        href="/blog"
        class="group w-[31.6vw] max-w-[660px] min-w-[420px] shrink-0"
      >
        <div class="aspect-[1.5/1] flex w-full items-center justify-center bg-[#2B2A27] transition-colors duration-300 group-hover:bg-[#DDD8D1]">
          <span class="text-[0.78rem] uppercase tracking-[0.22em] text-[#FAF9F7] transition-colors duration-300 group-hover:text-[#2B2A27]">
            Continue Reading
          </span>
        </div>
      </a>
    </div>

  </div>
</section>

<script>
  const scrollContainer = document.getElementById('ideas-scroll');
  const prevBtn = document.getElementById('ideas-prev');
  const nextBtn = document.getElementById('ideas-next');

  if (scrollContainer && prevBtn && nextBtn) {
    const getScrollAmount = () => {
      const firstCard = scrollContainer.querySelector('a');
      if (!firstCard) return 488;

      const cardWidth = firstCard.getBoundingClientRect().width;
      const styles = window.getComputedStyle(scrollContainer);
      const gap = parseFloat(styles.columnGap || styles.gap || '24');

      return cardWidth + gap;
    };

    prevBtn.addEventListener('click', () => {
      scrollContainer.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth',
      });
    });

    nextBtn.addEventListener('click', () => {
      scrollContainer.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth',
      });
    });
  }
</script>

<style>
  .scrollbar-hide {
    scrollbar-width: none;
  }

  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
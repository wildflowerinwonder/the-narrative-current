---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths = (async () => {
  const legals = await getCollection('legals');

  return legals.map((legalPage) => ({
    params: { legals: legalPage.id },
    props: { legal: legalPage },
  }));
}) satisfies GetStaticPaths;

const { legal } = Astro.props;
const { Content } = await render(legal);
---

<Layout title={legal.data.title} description={legal.data.description}>
  <main
    class="content-style w-full bg-[#FAF9F7] px-6 pt-13 pb-20 text-[#2B2A27] lg:px-20 lg:pt-28 lg:pb-28 xl:px-24 2xl:px-28"
  >
    <article class="w-full max-w-none">
      <Content />
    </article>
  </main>
</Layout>
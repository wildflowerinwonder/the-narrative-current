---
import Layout from '@/layouts/Layout.astro';
import { t } from '@/lib/utils';
---

<Layout title={t('meta.404.title')} description={t('meta.404.description')}>
  <section
    class="flex min-h-dvh items-center justify-center bg-[#FAF9F7] px-6 py-20 text-[#2B2A27] lg:px-20 lg:py-30 xl:px-24 2xl:px-28"
  >
    <div class="mx-auto max-w-[760px] text-center">
      <h1 class="text-[5rem] leading-none tracking-[-0.04em] md:text-[7rem] lg:text-[10rem]">
        {t('404.h1')}
      </h1>

      <div class="mt-8 space-y-5">
        <h2 class="text-[2rem] leading-[1.1] tracking-[-0.02em] md:text-[2.75rem] lg:text-[3.5rem]">
          {t('404.h2')}
        </h2>

        <p class="mx-auto max-w-[560px] text-[1rem] leading-[1.6] text-[#2B2A27]/70 md:text-[1.05rem]">
          {t('404.description')}
        </p>
      </div>

      <div class="mt-10 flex justify-center">
        <a
          href="/"
          class="inline-flex h-[50px] items-center justify-center rounded-[0.5rem] border border-[#2B2A27] bg-transparent px-6 text-[0.65rem] uppercase tracking-[0.18em] text-[#2B2A27] transition-all duration-300 hover:bg-[#2B2A27] hover:text-[#FAF9F7]"
        >
          {t('404.back.btn')}
        </a>
      </div>
    </div>
  </section>
</Layout>